# Copie para `.env` e preencha. Nada aqui é obrigatório para rodar em dev,
# mas SECRET_KEY e um provedor de e-mail são necessários em PRODUÇÃO.

# ── TMDB (pôsteres, resolução de títulos) ──────────────────────────────
# https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=seu_api_read_access_token_v4_aqui
TMDB_API_KEY=sua_chave_v3_aqui
TMDB_LANG=pt-BR

# ── Ambiente ─────────────────────────────────────────────────────────
# "production" torna SECRET_KEY obrigatória (o processo NÃO sobe sem ela) e
# liga a flag Secure dos cookies por padrão. Qualquer outro valor = dev.
RECOMENDAI_ENV=dev

# ── Sessão / autenticação ─────────────────────────────────────────────
# Assina o cookie de sessão, o cookie "remember" (Flask-Login) e os tokens de
# e-mail/reset. OBRIGATÓRIO com RECOMENDAI_ENV=production. Em dev, se vazio, o
# app gera e guarda uma chave em data/.secret_key (fora do git).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Força/desliga a flag Secure dos cookies. Vazio = segue RECOMENDAI_ENV.
# Ponha 1 sempre que servir por HTTPS (ex.: atrás do Caddy).
RECOMENDAI_COOKIE_SECURE=0

# ── E-mail transacional (verificação de conta, reset de senha) ─────────
# Sem SMTP_HOST, o app imprime o e-mail (com o link) no stdout — dá para
# testar o fluxo sem provedor. Em produção, configure um (Resend/SendGrid/SES…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RecomendAI <no-reply@seu-dominio>
SMTP_STARTTLS=1

# ── Serviço de inferência (docker-compose liga isto automaticamente) ──
# RECOMENDAI_INFERENCE_URL=http://inference:9000

# ── Limites / operação ───────────────────────────────────────────────
# O rate limit em memória vale só por processo. Rode a API com gunicorn -w 1
# (--threads N) OU aponte para Redis e volte a subir o nº de workers:
# RATELIMIT_STORAGE_URI=redis://redis:6379    # multi-worker/instância
# RECOMENDAI_RATE_SEARCH=30 per minute
# RECOMENDAI_TMDB_MAX_RPM=240
# RECOMENDAI_INDEX_DIR=retrieval/index_e5small   # modo baixa-latência/RAM
# RECOMENDAI_RERANK=0
